# armchair-debater - Environment Variables
# Copy this file to .env and fill in your API keys


# Gradium (STT/TTS) and General Compute (OpenAI-compatible LLM)
# Resolved from the shell environment (exported in ~/.zshrc) by python-dotenv
GRADIUM_API_KEY=${GRADIUM_API_KEY}
GRADIUM_VOICE_ID=_6Aslh2DxfmnRLmP
GENERAL_COMPUTE_API_KEY=${GENERAL_COMPUTE_API_KEY}
GENERAL_COMPUTE_MODEL=deepseek-v3.2

# Provider switches. Both default to the setup above; the two can be mixed
# (OpenAI's LLM with Gradium's streaming speech, say). See server/providers.py.
# LLM_PROVIDER=general_compute      # or: openai — the debater, the judge, the warm-up
# SPEECH_PROVIDER=gradium           # or: openai — speech-to-text and text-to-speech

# Only needed when a switch above says openai
# OPENAI_API_KEY=${OPENAI_API_KEY}
# OPENAI_MODEL=gpt-4.1              # Pipecat's OpenAILLMService default
# OPENAI_STT_MODEL=                 # unset: the service's default
# OPENAI_TTS_MODEL=                 # unset: the service's default
# OPENAI_TTS_VOICE=                 # unset: the service's default
