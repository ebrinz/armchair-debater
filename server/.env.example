# armchair-debater - Environment Variables
# Copy this file to .env and fill in your API keys


# Gradium (STT/TTS) and General Compute (OpenAI-compatible LLM)
# Resolved from the shell environment (exported in ~/.zshrc) by python-dotenv
GRADIUM_API_KEY=${GRADIUM_API_KEY}
# The house voice. The project's own is "The Armchair", a voice designed in the
# owner's Gradium account (an elderly, deep, gravelly, cranky professor) and so
# not usable from another account; this default is Rupert, a catalogue voice
# with the same depth and age that works for any key.
GRADIUM_VOICE_ID=kKmgHa8qUNt70kTT
GENERAL_COMPUTE_API_KEY=${GENERAL_COMPUTE_API_KEY}
GENERAL_COMPUTE_MODEL=deepseek-v3.2

# A voice of their own for the judge, who then reads the verdict (and the bot is
# told to read it as the judge). Unset: the house reads it in its own voice.
# GRADIUM_JUDGE_VOICE_ID=           # a Gradium voice ID of your choosing
# With SPEECH_PROVIDER=openai, name both: OPENAI_TTS_VOICE and OPENAI_JUDGE_VOICE

# Provider switches. Both default to the setup above; the two can be mixed
# (OpenAI's LLM with Gradium's streaming speech, say). See server/providers.py.
# LLM_PROVIDER=general_compute      # or: openai — the debater, the judge, the warm-up
# SPEECH_PROVIDER=gradium           # or: openai — speech-to-text and text-to-speech

# Only needed when a switch above says openai
# OPENAI_API_KEY=${OPENAI_API_KEY}
# OPENAI_MODEL=gpt-4.1              # Pipecat's OpenAILLMService default
# OPENAI_STT_MODEL=                 # unset: the service's default
# OPENAI_TTS_MODEL=                 # unset: the service's default
# OPENAI_TTS_VOICE=                 # unset: the service's default

# Lesson prompts carry the full theory card on step one only; set 1 to repeat it on
# every step (the original behaviour: larger prompts, slower replies).
# ARMCHAIR_LESSON_CARD_EVERY_STEP=1
